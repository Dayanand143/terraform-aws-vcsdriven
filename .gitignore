# =========================
# Terraform
# =========================

# Terraform working directory
# Includes downloaded providers and modules
.terraform/

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plans
*.tfplan
*.tfplan.json

# Terraform crash logs
crash.log
crash.*.log

# Terraform variable files
# Usually contain passwords, keys, account IDs, etc.
*.tfvars
*.tfvars.json

# Terraform CLI config
.terraformrc
terraform.rc

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json


# =========================
# Executables / Binaries
# =========================

*.exe
*.dll
*.so
*.dylib


# =========================
# Environment / Secrets
# =========================

.env
.env.*
!.env.example


# =========================
# IDE Files
# =========================

.vscode/
.idea/


# =========================
# OS Files
# =========================

.DS_Store
Thumbs.db


# =========================
# Logs
# =========================

*.log